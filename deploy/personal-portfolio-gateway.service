[Unit]
Description=PersonalPortfolio Cloudflare gateway

[Service]
User=portfolio
Group=portfolio
RuntimeDirectory=personal-portfolio-gateway
RuntimeDirectoryMode=0700
ExecStartPre=/usr/sbin/nginx -t -c /etc/personal-portfolio/gateway.conf
ExecStart=/usr/sbin/nginx -c /etc/personal-portfolio/gateway.conf -g 'daemon off;'
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
InaccessiblePaths=-/opt -/var/lib -/etc/cloudflared

[Install]
WantedBy=multi-user.target
