[Unit]
Description=PersonalPortfolio Gunicorn
After=network.target

[Service]
WorkingDirectory=%h/portfolio/current
EnvironmentFile=%h/portfolio/production.env
ExecStart=/usr/bin/env PORTFOLIO_DATABASE=%h/portfolio/current/database.sqlite %h/portfolio/current/.venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 2 wsgi:app
Restart=on-failure
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
